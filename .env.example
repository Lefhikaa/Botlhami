# Copy to .env for local overrides. In Azure, set these as App Service settings.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://botlhami.azurewebsites.net
# DATABASE_URL=postgres://user:password@host:5432/botlhami?sslmode=require
# Email through Azure Communication Services:
# EMAIL_BACKEND=core.email_backends.AzureCommunicationEmailBackend
# ACS_CONNECTION_STRING=endpoint=https://...;accesskey=...
# ACS_SENDER_ADDRESS=DoNotReply@your-domain.azurecomm.net
# SUPPORT_EMAIL=support@example.com
# Omang hashing key: a long random value. Never change it once set.
# OMANG_PEPPER=
# Optional: let the Botlhami Assistant word its answers with Azure OpenAI.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# CACHE_URL=rediscache://host:6380?ssl=true
DATA_RETENTION_MONTHS=24
